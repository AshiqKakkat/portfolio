import React from 'react';
import { motion } from 'framer-motion';

const experiences = [
  {
    role: "Software Engineer",
    company: "Codenex Solutions Pvt LLP",
    period: "Sep 2025 – Present",
    desc: "Engineered custom Shopify and WordPress websites, built full-stack MERN apps, and optimized Core Web Vitals.",
  },
  {
    role: "Web Developer",
    company: "Addax Digital",
    period: "Jun 2025 – Sep 2025",
    desc: "Designed and built custom WordPress and Shopify themes. Integrated APIs and payment gateways.",
  },
  {
    role: "MERN Stack Developer Intern",
    company: "Techolas Technologies",
    period: "Aug 2024 – Jan 2025",
    desc: "Built full-stack applications, developed reusable UI component libraries, and optimized backend performance.",
  }
];

const Experience = () => {
  return (
    <section id="experience" className="py-24 border-t border-white/5">
      <div className="w-full max-w-[1600px] mx-auto px-[4vw] lg:px-[3vw]">
        <motion.div 
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
          className="mb-16"
        >
          <h2 className="text-sm text-brand-green tracking-widest uppercase mb-4">Experience</h2>
          <h3 className="text-4xl md:text-5xl font-serif text-white max-w-3xl leading-tight">
            My Professional Journey
          </h3>
        </motion.div>

        <div className="space-y-12 relative">
          {/* Vertical Line */}
          <div className="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-white/10 hidden md:block"></div>
          
          {experiences.map((exp, index) => (
            <motion.div 
              key={index}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, delay: index * 0.1 }}
              className={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row-reverse' : ''} justify-between items-center w-full`}
            >
              <div className="w-full md:w-5/12 mb-4 md:mb-0">
                <div className={`p-6 glass rounded-2xl ${index % 2 === 0 ? 'md:text-left' : 'md:text-right'}`}>
                  <h4 className="text-xl font-bold text-white mb-1">{exp.role}</h4>
                  <div className="text-brand-green font-medium mb-3">{exp.company}</div>
                  <p className="text-gray-400 text-sm leading-relaxed">{exp.desc}</p>
                </div>
              </div>
              
              {/* Timeline dot */}
              <div className="hidden md:flex w-10 h-10 absolute left-1/2 -translate-x-1/2 bg-dark-bg border border-brand-green rounded-full items-center justify-center z-10">
                <div className="w-2 h-2 bg-brand-green rounded-full"></div>
              </div>

              <div className={`w-full md:w-5/12 ${index % 2 === 0 ? 'text-left md:text-right md:pr-12' : 'text-left md:pl-12'}`}>
                <span className="inline-block px-4 py-2 border border-white/10 rounded-full text-sm text-gray-300">
                  {exp.period}
                </span>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  );
